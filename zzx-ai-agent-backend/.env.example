# Runtime profile: development, test, or production
APP_ENV=development
SYSTEM_NAME=ZZX-AI-AGENT
APP_HOST=127.0.0.1
APP_PORT=8123
LOG_LEVEL=INFO

# DeepSeek
DEEPSEEK_API_KEY=replace-with-your-deepseek-api-key
DEEPSEEK_API_BASE=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-chat

# MySQL
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=replace-with-your-mysql-user
MYSQL_PASSWORD=replace-with-your-mysql-password
MYSQL_DB=zzx_agent_db

# Generate a long random value; never reuse the example text.
JWT_SECRET=replace-with-a-long-random-jwt-secret
JWT_ACCESS_TOKEN_MINUTES=30
JWT_REFRESH_TOKEN_DAYS=14
JWT_ISSUER=zzx-ai-agent
JWT_AUDIENCE=zzx-ai-agent-web

# Grants administrator role. Use a long random value in real deployments.
ADMIN_INVITE_CODE=replace-with-a-long-random-admin-invite-code

# Redis authentication state
REDIS_URL=redis://127.0.0.1:6379/0
REDIS_AUTH_PREFIX=zzx:auth
REDIS_CONNECT_TIMEOUT=2
REDIS_SOCKET_TIMEOUT=2

# Used when a browser calls this service directly. The Vite dev proxy is same-origin.
# Comma-separated, exact browser origins; do not use * with credentialed requests.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
