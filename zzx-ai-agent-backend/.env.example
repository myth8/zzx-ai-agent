# Runtime profile: development, test, or production
APP_ENV=development
SYSTEM_NAME=ZZX-AI-AGENT
APP_HOST=127.0.0.1
APP_PORT=8123
LOG_LEVEL=INFO

# DeepSeek
DEEPSEEK_API_KEY=replace-with-your-deepseek-api-key
DEEPSEEK_API_BASE=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-chat

# MySQL
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=replace-with-your-mysql-user
MYSQL_PASSWORD=replace-with-your-mysql-password
MYSQL_DB=zzx_agent_db

# Generate a long random value; never reuse the example text.
JWT_SECRET=replace-with-a-long-random-jwt-secret
